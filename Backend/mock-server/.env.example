# ========================================================
# SRGEC Admissions Mock Server Environment Variables
# ========================================================

# Server Port (Default: 8080)
PORT=8080

# Counselor Portal Authentication (Default: counselor / counselor@srgec)
COUNSELOR_USERNAME=counselor
COUNSELOR_PASSWORD=counselor@srgec
JWT_SECRET=srgecSecretKey2026!

# Optional Database (If omitted, local JSON files in data/ will be used automatically)
# DATABASE_URL=postgresql://username:password@localhost:5432/srgec_admissions

# Optional Google Gemini API Key for live AI Chatbot streaming
# If omitted, Nemo operates in honest built-in Knowledge-Base Fallback mode
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional Salesforce CRM Integration
# If omitted, admission leads are stored safely in local data/leads.json
# SF_CLIENT_ID=your_salesforce_connected_app_client_id
# SF_CLIENT_SECRET=your_salesforce_client_secret
# SF_MY_DOMAIN=yourcompany.my.salesforce.com

# Optional Twilio WhatsApp Sandbox Integration
# If omitted, SMS/WhatsApp triggers are logged safely to the console
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+14155238886
